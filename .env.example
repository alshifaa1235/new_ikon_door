# ==============================================================================
# NEW IKON DOORS — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Add these variables to your Vercel Project Settings (Settings -> Environment Variables)
# and copy to .env for local testing with Supabase.

# --- Supabase Database Integration (Optional - enables cloud persistence) ---
# Project URL from Supabase Dashboard (Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anon Key
SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Service Role Key (for secure server-side CRUD)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Admin Portal Authentication ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
